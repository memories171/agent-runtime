APP_ENV=development
AUTH_MODE=dev
DATABASE_URL=postgresql+asyncpg://agent_app:agent_app@localhost:5433/agent_runtime
DATABASE_MIGRATION_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent_runtime
AUTO_CREATE_DB=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-runtime
HARNESS_VERSION=financial-mvp-v0.2

# OIDC / JWT：生产环境 AUTH_MODE=oidc 时必填
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
JWT_ALGORITHMS=RS256,ES256
JWT_USER_CLAIM=sub
JWT_TENANT_CLAIM=tenant_id
JWT_ORGANIZATION_CLAIM=organization_id
JWT_ROLES_CLAIM=roles
JWT_PERMISSIONS_CLAIM=permissions
JWT_LEEWAY_SECONDS=30
JWKS_CACHE_TTL_SECONDS=300

# Optional OpenAI-compatible endpoint. Empty key enables deterministic demo planner.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=90

MAX_RUN_DURATION_SECONDS=7200
MAX_AGENT_STEPS=50
MAX_TOOL_RESULT_CHARS=20000
SKILLS_DIR=./skills
MCP_SERVERS_JSON=[]

# Task Graph Engine（默认关闭 graph 模式由 Run API 显式开启；以下为全局上限）
GRAPH_MAX_NODES=30
GRAPH_MAX_DEPTH=10
GRAPH_MAX_CONCURRENCY=5
GRAPH_MAX_NODE_STEPS=8
GRAPH_PLANNING_TIMEOUT_SECONDS=120
GRAPH_ALLOWED_HIGH_RISK_NODES=

# Sub-Agent Orchestration（Depth/Timeout/Cancel Grace）
ORCHESTRATION_MAX_DEPTH=3
ORCHESTRATION_CHILD_TIMEOUT_SECONDS=900
ORCHESTRATION_CHILD_CANCEL_GRACE_SECONDS=15
ORCHESTRATION_PARENT_CANCEL_GRACE_SECONDS=30
ORCHESTRATION_ALLOWED_AGENT_ROLES=executor,researcher,analyst,reviewer,summarizer,coordinator

# ============================================================
# 生产上线治理（最小实现）— 详见 docs/governance/PRODUCTION_GOVERNANCE.md
# 以下为占位；生产值必须由 HUMAN/ORG 流程提供，不得使用示例值上线。
# ============================================================
# 1 身份与租户安全：生产必须 AUTH_MODE=oidc，禁止 dev header 与 JWT claims 信任
TRUST_JWT_AUTHORIZATION_CLAIMS=false
# 2 数据治理：快照加密密钥（生产必填，KMS 托管）；存储后端 local|s3
SNAPSHOT_ENCRYPTION_KEYS=
SNAPSHOT_ENCRYPTION_KEY_ID=
SNAPSHOT_STORAGE_BACKEND=local
# 3 核心账务隔离：MCP server 默认空；生产仅经受控只读数据服务/命令服务
MCP_TLS_REQUIRED=true
# 5 合规决策边界：demo 监测规则不可用于生产；显式开启需审批引用
FINANCE_MONITORING_PRODUCTION_RULES=false
FINANCE_MONITORING_APPROVAL_REF=
# 7 监测规则验证：生产规则校准/审批由机构流程完成
MONITORING_RULES_APPROVAL_REF=
# 12 审计与可观测性：OTEL exporter（可选 extra observability）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=financial-agent-runtime
