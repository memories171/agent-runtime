# 默认使用纯前端演示数据，不需要后端服务
VITE_DATA_MODE=mock

# 只有连接你自己的后端时才改为 api，并填写后端地址
# VITE_DATA_MODE=api
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_TENANT_ID=demo-bank
VITE_USER_ID=analyst-01
# 仅用于 mock 模式演示；API 模式不信任浏览器自报权限
VITE_SCOPES=agent:execute,runs:read:tenant,runs:manage:tenant,financial:customer:read,financial:account:read,financial:transactions:read,financial:monitoring:run,financial:case:create,financial:case:read,financial:audit:read,memory:read,memory:read:team,memory:read:organization,memory:write,memory:write:team,memory:write:organization,memory:write:tenant,approval:approve,financial:case:approve,skills:manage,security:read,platform:manage

# API 模式 OIDC Authorization Code + PKCE（必填）
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_URI=http://localhost:5173
